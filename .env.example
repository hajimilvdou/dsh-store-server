# 复制为 .env 并填写真实值。
# 密钥类（GitHub 搜索 token / OAuth / JWT / 管理员密码）现在优先在管理端「配置中心」填写（保存即热更新）；
# 下面的环境变量仅作首启兜底，可不填。

# ---- 数据库 ----
DB_PASSWORD=change-me

# ---- 镜像部署（GitHub Actions 构建 → GHCR，服务器直接拉取）----
# GitHub 用户名/仓库名（不含 ghcr.io 前缀），本项目 = hajimilvdou/dsh-store-server
GH_IMAGE=hajimilvdou/dsh-store-server
# 拉取镜像的 tag（默认 latest）
TAG=

# ---- GitHub 抓取 token 池（逗号分隔，×3 轮换用；需 classic PAT，Search API 不支持细粒度 token）
# 也可以在管理端「配置中心 → GitHub 库同步」一行一个填写（多枚轮换）
GITHUB_TOKENS=
# 同步搜索的 topic（仓库打上该 topic 即被收录，默认 dsh-plugin）
SYNC_TOPIC=dsh-plugin
# 单次同步收录上限：0 = 全量搜完（星数区间拆分补齐，不受 1000 上限影响）；>0 = 只收录前 N 个
SYNC_MAX_REPOS=0

# ---- GitHub OAuth App（回调地址填服务器域名）----
# 也可以在管理端「配置中心 → 认证凭证」填写
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# OAuth 回调基础地址（默认按请求 host 自动拼接 /auth/callback；反代/域名场景显式配置，需与 OAuth App 注册的回调完全一致）
OAUTH_CALLBACK_URL=

# ---- 签名 / JWT（也可以在配置中心填写；更换后全员重新登录）----
JWT_SECRET=

# ---- 服务端 ----
PORT=8080
HOST=0.0.0.0
# 管理端口令（生产环境必填强随机值；未配置时管理端 503 不可用 = 默认安全。
# 仅纯离线演示模式——未配置 OAuth 且未配置 GitHub token——默认 mock-admin）
ADMIN_TOKEN=
# 用户客户端连接本服务器的访问密码（自部署可改，改密后旧客户端需更新）
ACCESS_PASSWORD=
# 服务器间联邦密码（≠ 访问密码，仅双方管理员知晓）
FEDERATION_ENABLED=true
FEDERATION_SECRET=
# 一键更新检测的项目 GitHub 地址（如 https://github.com/your-org/dsh-store-server；
# 管理端「系统更新」页可保存 + 手动一键检测）
UPDATE_REPO_URL=
# 所属 LB 集群 id（独立源留空）
CLUSTER_ID=
